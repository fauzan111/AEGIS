#ED7100;strokeColor=none;fontColor=#FFFFFF;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1445" y="754" width="22" height="22" as="geometry"/></mxCell><mxCell id="c121" value="7" style="ellipse;html=1;fontFamily=Helvetica;fontSize=11;fontStyle=1;fillColor=#ED7100;strokeColor=none;fontColor=#FFFFFF;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1094" y="598" width="22" height="22" as="geometry"/></mxCell><mxCell id="c122" value="8" style="ellipse;html=1;fontFamily=Helvetica;fontSize=11;fontStyle=1;fillColor=#ED7100;strokeColor=none;fontColor=#FFFFFF;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1230" y="598" width="22" height="22" as="geometry"/></mxCell><mxCell id="c123" value="9" style="ellipse;html=1;fontFamily=Helvetica;fontSize=11;fontStyle=1;fillColor=#ED7100;strokeColor=none;fontColor=#FFFFFF;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1445" y="440" width="22" height="22" as="geometry"/></mxCell><mxCell id="c124" value="10" style="ellipse;html=1;fontFamily=Helvetica;fontSize=11;fontStyle=1;fillColor=#ED7100;strokeColor=none;fontColor=#FFFFFF;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="400" y="46" width="22" height="22" as="geometry"/></mxCell><mxCell id="c125" value="10" style="ellipse;html=1;fontFamily=Helvetica;fontSize=11;fontStyle=1;fillColor=#ED7100;strokeColor=none;fontColor=#FFFFFF;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1600" y="340" width="22" height="22" as="geometry"/></mxCell><mxCell id="c126" value="" style="rounded=1;arcSize=2;html=1;fillColor=#FAFAFA;strokeColor=#232F3E;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1970" y="40" width="580" height="1200" as="geometry"/></mxCell><mxCell id="c127" value="AEGIS MVP on AWS  -  Open5GS 5G core on Amazon EKS" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=16;fontColor=#232F3E;align=left;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1990" y="56" width="540" height="26" as="geometry"/></mxCell><mxCell id="c128" value="Zero-trust gate for machine identities: AEGIS fingerprints how each AI agent calls the 5G Service-Based Interface (SBI) and scores every request window, so a stolen-but-valid credential is still caught by behaviour. The MVP runs a real Open5GS SA core + UERANSIM on EKS, real AI agents on Amazon Bedrock AgentCore reasoning with a Bedrock LLM, captures genuine HTTP/2 SBI signalling, scores it with the AEGIS pipeline (PASS / STEP-UP / BLOCK) and publishes the dashboard through CloudFront. One region, one AZ, torn down with terraform destroy." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1990" y="90" width="540" height="92" as="geometry"/></mxCell><mxCell id="c129" value="End-to-end flow" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#232F3E;align=left;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1990" y="194" width="540" height="22" as="geometry"/></mxCell><mxCell id="c130" value="1" style="ellipse;html=1;fontFamily=Helvetica;fontSize=11;fontStyle=1;fillColor=#ED7100;strokeColor=none;fontColor=#FFFFFF;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1990" y="228" width="22" height="22" as="geometry"/></mxCell><mxCell id="c131" value="Operator provisions VPC, EKS, ECR, S3, AgentCore and CloudFront with Terraform and installs the pinned Helm charts (open5gs, ueransim, aegis) through the EKS API, authenticated by IAM." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="2024" y="230" width="506" height="50" as="geometry"/></mxCell><mxCell id="c132" value="2" style="ellipse;html=1;fontFamily=Helvetica;fontSize=11;fontStyle=1;fillColor=#ED7100;strokeColor=none;fontColor=#FFFFFF;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1990" y="285" width="22" height="22" as="geometry"/></mxCell><mxCell id="c133" value="Worker nodes pull pinned container images from Amazon ECR; upstream charts are fetched through the NAT gateway (egress only, no inbound path)." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="2024" y="287" width="506" height="50" as="geometry"/></mxCell><mxCell id="c134" value="3" style="ellipse;html=1;fontFamily=Helvetica;fontSize=11;fontStyle=1;fillColor=#ED7100;strokeColor=none;fontColor=#FFFFFF;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1990" y="342" width="22" height="22" as="geometry"/></mxCell><mxCell id="c135" value="The UERANSIM UE attaches to the simulated gNB; the gNB opens N2 (NGAP over SCTP, in-cluster) to the AMF and the UE registers; user plane flows gNB to UPF over N3 (GTP-U)." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="2024" y="344" width="506" height="50" as="geometry"/></mxCell><mxCell id="c136" value="4" style="ellipse;html=1;fontFamily=Helvetica;fontSize=11;fontStyle=1;fillColor=#ED7100;strokeColor=none;fontColor=#FFFFFF;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1990" y="399" width="22" height="22" as="geometry"/></mxCell><mxCell id="c137" value="Core NFs exchange SBI HTTP/2 calls (:7777) through the SCP: AUSF/UDM authentication, PCF policy, SMF PDU session; the SMF programs the UPF over N4." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="2024" y="401" width="506" height="50" as="geometry"/></mxCell><mxCell id="c138" value="5" style="ellipse;html=1;fontFamily=Helvetica;fontSize=11;fontStyle=1;fillColor=#ED7100;strokeColor=none;fontColor=#FFFFFF;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1990" y="456" width="22" height="22" as="geometry"/></mxCell><mxCell id="c139" value="The AI agents run on Bedrock AgentCore Runtime and reason with an LLM on Amazon Bedrock to decide their network actions; the rogue agent runs a malicious goal or injected prompt." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="2024" y="458" width="506" height="50" as="geometry"/></mxCell><mxCell id="c140" value="6" style="ellipse;html=1;fontFamily=Helvetica;fontSize=11;fontStyle=1;fillColor=#ED7100;strokeColor=none;fontColor=#FFFFFF;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1990" y="513" width="22" height="22" as="geometry"/></mxCell><mxCell id="c141" value="AgentCore (VPC mode, ENIs in the private subnet) calls SBI APIs via the internal NLB to the SCP with a valid AgentCore Identity token: phase 1 legit baseline, phase 2 rogue behaviour." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="2024" y="515" width="506" height="50" as="geometry"/></mxCell><mxCell id="c142" value="7" style="ellipse;html=1;fontFamily=Helvetica;fontSize=11;fontStyle=1;fillColor=#ED7100;strokeColor=none;fontColor=#FFFFFF;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1990" y="570" width="22" height="22" as="geometry"/></mxCell><mxCell id="c143" value="SBI tap: the capture Job (pinned to the SCP node, host network) runs tcpdump on the SCP pod interface for :7777; the parser builds the AEGIS CSV, taking agent identity from the token header." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="2024" y="572" width="506" height="50" as="geometry"/></mxCell><mxCell id="c144" value="8" style="ellipse;html=1;fontFamily=Helvetica;fontSize=11;fontStyle=1;fillColor=#ED7100;strokeColor=none;fontColor=#FFFFFF;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1990" y="627" width="22" height="22" as="geometry"/></mxCell><mxCell id="c145" value="The capture Job uploads the raw pcap and the parsed CSV to Amazon S3 (IRSA, write-only, 7-day lifecycle expiry)." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="2024" y="629" width="506" height="50" as="geometry"/></mxCell><mxCell id="c146" value="9" style="ellipse;html=1;fontFamily=Helvetica;fontSize=11;fontStyle=1;fillColor=#ED7100;strokeColor=none;fontColor=#FFFFFF;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1990" y="684" width="22" height="22" as="geometry"/></mxCell><mxCell id="c147" value="The AEGIS gate pod reads the CSV and runs OBSERVE, FINGERPRINT, SCORE (rules + Isolation Forest) and DECIDE, then writes the scored windows back to S3." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="2024" y="686" width="506" height="50" as="geometry"/></mxCell><mxCell id="c148" value="10" style="ellipse;html=1;fontFamily=Helvetica;fontSize=11;fontStyle=1;fillColor=#ED7100;strokeColor=none;fontColor=#FFFFFF;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1990" y="741" width="22" height="22" as="geometry"/></mxCell><mxCell id="c149" value="The operator opens the dashboard over HTTPS: AWS WAF (IP allowlist) and CloudFront forward to the internal ALB (VPC origin, WebSocket, no caching): per-agent risk and PASS / STEP-UP / BLOCK." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="2024" y="743" width="506" height="50" as="geometry"/></mxCell><mxCell id="c150" value="Line key" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#232F3E;align=left;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1990" y="810" width="540" height="22" as="geometry"/></mxCell><mxCell id="c151" value="" style="point;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1994" y="851" width="0.1" height="0.1" as="geometry"/></mxCell><mxCell id="c152" value="" style="point;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2054" y="851" width="0.1" height="0.1" as="geometry"/></mxCell><mxCell id="c153" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#545B64;strokeWidth=1.5;" edge="1" parent="1" source="c151" target="c152"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c154" value="5G signalling / platform traffic (N2, N3, N4, SBI, images, API)" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="2070" y="840" width="460" height="22" as="geometry"/></mxCell><mxCell id="c155" value="" style="point;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1994" y="879" width="0.1" height="0.1" as="geometry"/></mxCell><mxCell id="c156" value="" style="point;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2054" y="879" width="0.1" height="0.1" as="geometry"/></mxCell><mxCell id="c157" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#01A88D;strokeWidth=1.5;" edge="1" parent="1" source="c155" target="c156"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c158" value="Agent LLM inference (AgentCore to Amazon Bedrock)" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="2070" y="868" width="460" height="22" as="geometry"/></mxCell><mxCell id="c159" value="" style="point;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1994" y="907" width="0.1" height="0.1" as="geometry"/></mxCell><mxCell id="c160" value="" style="point;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2054" y="907" width="0.1" height="0.1" as="geometry"/></mxCell><mxCell id="c161" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#DD344C;strokeWidth=1.5;" edge="1" parent="1" source="c159" target="c160"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c162" value="AI-agent SBI calls under evaluation" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="2070" y="896" width="460" height="22" as="geometry"/></mxCell><mxCell id="c163" value="" style="point;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1994" y="935" width="0.1" height="0.1" as="geometry"/></mxCell><mxCell id="c164" value="" style="point;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2054" y="935" width="0.1" height="0.1" as="geometry"/></mxCell><mxCell id="c165" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#DD344C;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="c163" target="c164"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c166" value="Passive SBI capture (read-only tap, no change to NFs)" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="2070" y="924" width="460" height="22" as="geometry"/></mxCell><mxCell id="c167" value="" style="point;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1994" y="963" width="0.1" height="0.1" as="geometry"/></mxCell><mxCell id="c168" value="" style="point;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2054" y="963" width="0.1" height="0.1" as="geometry"/></mxCell><mxCell id="c169" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#ED7100;strokeWidth=1.5;" edge="1" parent="1" source="c167" target="c168"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c170" value="AEGIS data path (pcap / CSV / scored windows)" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="2070" y="952" width="460" height="22" as="geometry"/></mxCell><mxCell id="c171" value="" style="point;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1994" y="991" width="0.1" height="0.1" as="geometry"/></mxCell><mxCell id="c172" value="" style="point;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2054" y="991" width="0.1" height="0.1" as="geometry"/></mxCell><mxCell id="c173" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#8C4FFF;strokeWidth=1.5;" edge="1" parent="1" source="c171" target="c172"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c174" value="Dashboard access (HTTPS via WAF and CloudFront)" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="2070" y="980" width="460" height="22" as="geometry"/></mxCell><mxCell id="c175" value="" style="point;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1994" y="1019" width="0.1" height="0.1" as="geometry"/></mxCell><mxCell id="c176" value="" style="point;html=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="2054" y="1019" width="0.1" height="0.1" as="geometry"/></mxCell><mxCell id="c177" style="edgeStyle=none;html=1;rounded=0;endArrow=block;endFill=1;startArrow=none;startFill=1;strokeColor=#545B64;strokeWidth=1.5;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="c175" target="c176"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c178" value="Pod logs to CloudWatch (Container Insights)" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="2070" y="1008" width="460" height="22" as="geometry"/></mxCell><mxCell id="c179" value="" style="rounded=0;html=1;fillColor=#545B64;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1994" y="1045" width="60" height="4" as="geometry"/></mxCell><mxCell id="c180" value="SBI service bus (all NF-to-NF calls go through the SCP)" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="2070" y="1036" width="460" height="22" as="geometry"/></mxCell><mxCell id="c181" value="n" style="ellipse;html=1;fontFamily=Helvetica;fontSize=11;fontStyle=1;fillColor=#ED7100;strokeColor=none;fontColor=#FFFFFF;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="2013" y="1064" width="22" height="22" as="geometry"/></mxCell><mxCell id="c182" value="Step of the end-to-end flow above" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="2070" y="1064" width="460" height="22" as="geometry"/></mxCell><mxCell id="c183" value="Security and cost guardrails" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#232F3E;align=left;verticalAlign=middle;spacing=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1990" y="1100" width="540" height="22" as="geometry"/></mxCell><mxCell id="c184" value="- Single public entry point: CloudFront + WAF IP allowlist; ALB and NLB are internal; NF Services are ClusterIP; the NLB only accepts the AgentCore security group.&lt;br&gt;- Least privilege: capture Job s3:PutObject, AEGIS gate s3:GetObject/PutObject, AgentCore role bedrock:InvokeModel on a single model ARN.&lt;br&gt;- Synthetic subscriber K/OP in a namespaced Kubernetes Secret, never real SIM data.&lt;br&gt;- Single AZ, on-demand nodes, no HA; terraform destroy removes all billable resources." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#232F3E;align=left;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1990" y="1128" width="540" height="92" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>